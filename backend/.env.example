# ---- Server ----
PORT=5000
NODE_ENV=development

# Public URL of THIS backend (used to build image URLs). No trailing slash.
SERVER_URL=http://localhost:5000

# Frontend origin allowed by CORS. No trailing slash.
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/car_rental
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxx.mongodb.net/car_rental
MONGO_URI=mongodb://127.0.0.1:27017/car_rental

# ---- Auth ----
JWT_SECRET=super_secret_change_me_in_production
JWT_EXPIRE=30d

# ---- Business rules ----
REGISTRATION_FEE=500

# ---- Seed admin account ----
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@driveease.com
ADMIN_PASSWORD=Admin@123
ADMIN_MOBILE=9999999999
